generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Resume {
  id        String   @id @default(cuid())
  userId    String
  title     String
  status    Status   @default(DRAFT)
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

enum Status {
  DRAFT
  PUBLISHED
}
