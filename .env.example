# Used by Prisma when running the app directly on the host (pnpm dev),
# pointing at the `db` service published by docker-compose.yml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resume_manager?schema=public"

# Read by docker-compose.yml for the `db` service; safe local-only defaults.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=resume_manager
